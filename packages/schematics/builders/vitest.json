{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "NgNativeVitestBuilder",
  "title": "Vitest",
  "type": "object",
  "properties": {
    "watch": {
      "type": "boolean",
      "description": "Keep running and re-run on change.",
