{
  "name": "@ng-native/device",
  "version": "0.0.0",
  "description": "Angular Native device services: keyboard, screen, colour scheme, app state, accessibility, hardware back and deep links.",
  "type": "module",
  "main": "src/index.ts",
  "dependencies": {
    "@ng-native/fabric": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0",
    "react-native": ">=0.86.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "nx": {
    "tags": [
      "scope:device",
      "layer:device"
    ]
  },
  "scripts": {
    "build": "ngc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ng-native/ng-native.git",
    "directory": "packages/device"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@angular/core": "22.2.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
