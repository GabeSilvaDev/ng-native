{
  "name": "@ng-native/tailwind",
  "version": "0.0.0",
  "description": "Tailwind CSS preset for Angular Native, for native and web.",
  "type": "commonjs",
  "main": "flatten.cjs",
  "dependencies": {
    "@ng-native/metro": "workspace:*",
